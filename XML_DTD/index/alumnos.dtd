<!ELEMENT lista_alumnos (alumno+)>
<!ELEMENT alumno (nombre, apellidos, domicilio, telefono+, equipo?, aficion*, origen, notas, comentarios?)>

<!ATTLIST alumno
     num_alumno ID #REQUIRED
     altura CDATA #IMPLIED
     sexo (hombre | mujer) #IMPLIED
     ayudado_por IDREF #IMPLIED>

<!ELEMENT nombre (#PCDATA)>
<!ELEMENT apellidos (#PCDATA)>
<!ELEMENT domicilio (#PCDATA)>

<!ELEMENT  telefono (#PCDATA)>
<!ATTLIST telefono
     tipo (propio | padre | madre | tutor) #REQUIRED>

<!ELEMENT equipo (#PCDATA)>
<!ELEMENT aficion (#PCDATA)>

<!ELEMENT origen (provincia | pais)>
<!ELEMENT provincia (#PCDATA)>
<!ELEMENT pais (#PCDATA)>

<!ELEMENT notas (evaluacion, calificacion)+>
<!ELEMENT evaluacion (#PCDATA)>
<!ELEMENT calificacion (#PCDATA)>

<!ELEMENT comentarios ANY>
