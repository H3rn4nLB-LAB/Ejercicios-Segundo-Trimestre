<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://w3.org">


  <xs:element name="tabla_periodica">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="atomo" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nombre" type="tipoNombre"/>
              <xs:element name="simbolo" type="tipoSimbolo"/>
              <xs:element name="numero_atomico" type="tipoNumeroAtomico"/>
              <xs:element name="peso_atomico" type="xs:decimal"/>
              <xs:element name="punto_ebullicion" type="tipoPuntoEbullicion"/>
              <xs:element name="densidad" type="tipoDensidad"/>
            </xs:sequence>
            <xs:attribute name="estado" type="tipoEstado" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>


  <xs:simpleType name="tipoEstado">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sólido"/>
      <xs:enumeration value="líquido"/>
      <xs:enumeration value="gaseoso"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="tipoNombre">
    <xs:restriction base="xs:string">
      <xs:maxLength value="15"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="tipoSimbolo">
    <xs:restriction base="xs:string">
      <xs:maxLength value="3"/>
      <xs:pattern value="[A-Z][a-z]{0,2}"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="tipoNumeroAtomico">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="118"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:complexType name="tipoPuntoEbullicion">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="unidades" default="centigrados">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="centigrados"/>
              <xs:enumeration value="kelvin"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  
  <xs:complexType name="tipoDensidad">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="unidades" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>
